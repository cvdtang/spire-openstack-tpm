version: 2
ethernets:
  eth0:
    match: {macaddress: "52:54:00:96:00:13"}
    set-name: eth0
    addresses: [192.168.150.13/24]
    routes: [{to: default, via: 192.168.150.1}]
    nameservers: {addresses: [1.1.1.1, 8.8.8.8]}
  # br0's port, which puts the node on the provider network's L2.
  eth1:
    match: {macaddress: "52:54:00:96:01:13"}
    set-name: eth1
    dhcp4: false
    dhcp6: false
    accept-ra: false
    link-local: []
bridges:
  br0:
    interfaces: [eth1]
    dhcp4: false
    dhcp6: false
    accept-ra: false
    link-local: []
    parameters: {stp: false, forward-delay: 0}
