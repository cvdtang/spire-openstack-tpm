# Lab constants, sourced by the lab scripts and parsed by the e2e tests.

# Addresses on otpm-mgmt of this host (the Compose project), compute-1 (Kolla all-in-one) and bmc (the node's BMC).
HOST_IP=192.168.150.1
CTL_IP=192.168.150.11
BMC_IP=192.168.150.13
KEYSTONE_URL=http://192.168.150.11:5000/v3
NOVA_URL=http://192.168.150.11:8774/v2.1
NEUTRON_URL=http://192.168.150.11:9696
IRONIC_URL=http://192.168.150.11:6385
REGION=RegionOne
DOMAIN_ID=default

# The issuer, which the hypervisor hook and IPA call, and its health endpoint on this host's loopback.
ISSUER_URL=https://192.168.150.1:9443
ISSUER_HEALTH_URL=http://127.0.0.1:8098/healthz
ISSUING_KEY=issuing
CLEAR_KEY=clear
# OpenBao runs in dev mode on 127.0.0.1:8200 with this root token.
OPENBAO_ADDR=http://127.0.0.1:8200
OPENBAO_TOKEN=lab-root
ISSUER_IMAGE=openstack-tpm-issuer:lab
OPENBAO_IMAGE=quay.io/openbao/openbao:2.7.2

# The tenant's SPIRE server, the central one and those the e2e tests start, all containers on this host.
SPIRE_VERSION=1.16.0
SPIRE_SERVER_IMAGE=ghcr.io/spiffe/spire-server:1.16.0
SPIRE_TRUST_DOMAIN=openstack-tpm.lab
SPIRE_PORT=8081
SPIRE_CONTAINER=spire-server
CENTRAL_TRUST_DOMAIN=central.openstack-tpm.lab
CENTRAL_PORT=18082
CENTRAL_CONTAINER=spire-server-central
TEST_SPIRE_PORT=18083
SPIRE_SOCKET=/run/spire-server/api.sock

# OpenStack resources the provisioning creates.
TENANT=tenant-a
NETWORK=tenant-a-net
SECURITY_GROUP=spire-agent
OTHER_PROJECT=admin
OTHER_NETWORK=demo-net
EXTERNAL_NETWORK=public1
FIP_PREFIX=192.168.150.
CIRROS_IMAGE=cirros
PLAIN_FLAVOR=m1.plain
KEYPAIR=openstack-tpm
CENTRAL_USER=spire-central
NOROLE_USER=spire-norole

LINUX_IMAGE=ubuntu-resolute
LINUX_FLAVOR=m1.vtpm
LINUX_USER=ubuntu
WINDOWS_IMAGE=windows-server-2025
WINDOWS_FLAVOR=w1.vtpm
WINDOWS_USER=Administrator

# The bare-metal node: a VM nested in bmc, powered through sushy-tools there.
BM_NODE=bm-1
BM_FLAVOR=bm.small
BM_NETWORK=public1
BM_MAC=52:54:00:96:02:01
BMC_PORT=8000
# The node's libvirt domain UUID in bmc, which sushy-tools serves as /redfish/v1/Systems/<uuid>.
BM_UUID=4f1c2a3e-6b7d-4e8f-9a0b-1c2d3e4f5a6b
